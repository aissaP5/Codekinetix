# =================================================================
# CODEKINETIX EMAILJS CONFIGURATION
# Destination email: codekinetixstudio@gmail.com
# =================================================================

# 1. Create a free account at https://www.emailjs.com/
# 2. Add an Email Service connected to codekinetixstudio@gmail.com (e.g. Gmail) -> Copy Service ID
# 3. Create an Email Template with variables:
#    {{from_name}}, {{from_email}}, {{service}}, {{budget}}, {{timeline}}, {{message}}
#    Set "To Email" in EmailJS template to codekinetixstudio@gmail.com -> Copy Template ID
# 4. Copy your Public Key from Account > API Keys

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional: Server-side private key (if using API route server dispatch)
EMAILJS_PRIVATE_KEY=
